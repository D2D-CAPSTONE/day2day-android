<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_composite"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_composite"
        android:supportsRtl="true"
        android:theme="@style/Theme.Day2day"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.recommend.flow.CourseDetailPageActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.recommend.flow.CourseMapPageActivity"
            android:exported="false"
            android:theme="@style/Theme.Day2day.NoActionBar" />

        <activity
            android:name=".presentation.recommend.flow.FilteringActivity"
            android:exported="false"
            android:theme="@style/Theme.Day2day.NoActionBar" />

        <activity
            android:name=".presentation.recommend.flow.MapPageActivity"
            android:exported="false"
            android:theme="@style/Theme.Day2day.NoActionBar" />

        <activity
            android:name=".presentation.recommend.flow.StartLocationPickerActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.recommend.flow.MapSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Day2day.NoActionBar" />

        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Day2day.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Day2day.Main" />

        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="rfoug2ufoy" />

    </application>

</manifest>
