<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_course_order_rank"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/shape_tag_rose"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/rose"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_course_order_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="놀거리"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="음식점" />

            <TextView
                android:id="@+id/tv_course_order_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="길게 눌러 이동"
                android:textColor="@color/text_medium"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_course_order_drag"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/text_medium" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
