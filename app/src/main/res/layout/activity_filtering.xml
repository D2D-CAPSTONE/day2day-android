<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:id="@+id/filtering_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_filtering_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="필터 설정"
            android:textColor="@color/rose"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/filtering_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toTopOf="@id/btn_filtering_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filtering_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="데이터 시작 위치"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cream"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_filtering_location_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="현재 위치 기준으로 추천해요."
                        android:textColor="@color/text_medium"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundMode="none"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_mapmode"
                        app:endIconTint="@color/rose"
                        app:startIconDrawable="@android:drawable/ic_menu_mylocation"
                        app:startIconTint="@color/rose">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_filtering_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:focusable="false"
                            android:paddingTop="12dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            tools:text="위도 37.56661 / 경도 126.97838" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filtering_use_current_location"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="현재 위치로 다시 설정"
                android:textColor="@color/rose"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/rose_light"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/rose" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filtering_adjust_location_on_map"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="지도에서 시작 위치 조정"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_mapmode"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/text_dark"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="원하는 분위기"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_mood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기분전환"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="조용한"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가성비"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="활동적인"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분위기 좋은"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비 오는 날"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인스타 감성"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="야외 좌석"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="반려동물 동반"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@android:color/white"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeColor="#D1D1D1"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="정렬 기준"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cream"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/rg_sort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rb_recommended"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_recommended"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="추천순"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_distance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="거리순"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_review"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="리뷰 많은 순"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_filtering_next"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="주변 코스 추천받기"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/rose"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
